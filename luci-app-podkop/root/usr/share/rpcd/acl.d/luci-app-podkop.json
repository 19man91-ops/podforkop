{
  "luci-app-podkop": {
    "description": "Grant UCI and RPC access to LuCI app podkop",
    "read": {
      "file": {
        "/etc/init.d/podkop": [
          "exec"
        ],
        "/usr/bin/podkop": [
          "exec"
        ],
        "/tmp/dhcp.leases": [
          "read"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ],
        "luci-rpc": [
          "getDHCPLeases",
          "getHostHints"
        ],
        "network.interface": [
          "dump"
        ]
      },
      "uci": [
        "podkop",
        "dhcp",
        "network"
      ]
    },
    "write": {
      "uci": [
        "podkop"
      ]
    }
  }
}
